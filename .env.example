# Multi-Accounts Content Pipeline Configuration
# =========================================
# Copy this file to .env and fill in your values

# ============================================================================
# CORE CONFIGURATION (Required)
# ============================================================================

# API Configuration
OPENCODE_BASE_URL=http://your-api-url:1430/v1
OPENCODE_API_KEY=your-api-key-here

# ============================================================================
# MODEL ROUTING CONFIGURATION (Simple - Per Task)
# ============================================================================
# Each task has 3 models: Primary (Utama) → Fallback1 (FB1) → Fallback2 (FB2)
# System automatically falls back when primary fails

# TASK: STRATEGIST (Ideation & Strategy)
MODEL_STRATEGIST_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_STRATEGIST_FB1=ag/gemini-3.8-flash-high
MODEL_STRATEGIST_FB2=ds-web/deepseek-v4-flash

# TASK: WRITER (Content Generation)
MODEL_WRITER_PRIMARY=cx/gpt-6-luna
MODEL_WRITER_FB1=ds-web/deepseek-v4-flash
MODEL_WRITER_FB2=ag/gemini-3.8-flash-high

# TASK: VISUAL (Visual Brief Generation)
MODEL_VISUAL_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_VISUAL_FB1=ds-web/deepseek-v4-flash
MODEL_VISUAL_FB2=gemini/gemini-3.5-flash-lite

# TASK: ENGAGEMENT (Engagement Strategy)
MODEL_ENGAGEMENT_PRIMARY=cbcn/deepseek-v4.1-flash
MODEL_ENGAGEMENT_FB1=ds-web/deepseek-v4-flash
MODEL_ENGAGEMENT_FB2=groq/openai/gpt-oss-120b

# TASK: QC (Quality Control & Review)
MODEL_QC_PRIMARY=cx/gpt-6-luna
MODEL_QC_FB1=cbcn/deepseek-v4.1-flash
MODEL_QC_FB2=ds-web/deepseek-v4-flash

# Legacy single-model config (backward compatibility)
MODEL_STRATEGIST=cbcn/deepseek-v4.1-flash
MODEL_WRITER=cx/gpt-6-luna
MODEL_VISUAL=cbcn/deepseek-v4.1-flash
MODEL_ENGAGEMENT=cbcn/deepseek-v4.1-flash
MODEL_QC=cx/gpt-6-luna
MODEL_DEFAULT=cx/gpt-6-luna

# Weekly Content Limits (per account)
# Set to 0 for unlimited
WEEKLY_LIMIT_THREAD=0
WEEKLY_LIMIT_SINGLE_TWEET=0
WEEKLY_LIMIT_POLL=0
WEEKLY_LIMIT_IMAGE=0

# Fresh Topics Configuration
ENABLE_FRESH_TOPICS=1

# Visual & Engagement Generation Toggles (1/true = on, 0/false = off/skip)
ENABLE_VISUAL=0
ENABLE_ENGAGEMENT=0

# Daily Cron Batch Configuration
CRON_MAX_ACCOUNTS=3
WEEKLY_MAX_POSTS_PER_ACCOUNT=5

# ============================================================================
# MONITORING & OBSERVABILITY (Optional - Disabled by default)
# ============================================================================

# ENABLE_METRICS=1
# ENABLE_HEALTH_CHECK=1
# ENABLE_JSON_LOGS=1
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# RELIABILITY & RESILIENCE (Optional - Disabled by default)
# ============================================================================

# ENABLE_CIRCUIT_BREAKER=1
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# CIRCUIT_BREAKER_TIMEOUT=300

# ENABLE_RETRY_BUDGET=1
# RETRY_BUDGET_DAILY=10

# ============================================================================
# CONTENT VERSIONING (Optional - Disabled by default)
# ============================================================================

# ENABLE_VERSIONING=1
# VERSION_RETENTION=5

# ============================================================================
# DISCORD INTEGRATION (Optional)
# ============================================================================
# Setup guide: docs/INTEGRATION.md

# Discord bot token
# DISCORD_TOKEN=your-discord-bot-token

# Discord Channel A: Angle selection notifications (optional)
# DISCORD_CHANNEL_A_ID=123456789012345678

# Discord Channel B: Final content packages (recommended)
# DISCORD_CHANNEL_B_ID=123456789012345678

# ============================================================================
# BUFFER INTEGRATION (Optional)
# ============================================================================
# Setup guide: docs/INTEGRATION.md

# Global Buffer toggle
BUFFER_ENABLED=true

# Per-account credentials in accounts/{account_id}/buffer.json
# See accounts/buffer.json.example for template

# ============================================================================
# DEBUG & DEVELOPMENT
# ============================================================================

DEBUG_DEDUP=0

# ============================================================================
# DOCKER & SCHEDULER DAEMON CONFIGURATION
# ============================================================================
TIMEZONE=Asia/Jakarta
CRON_SCHEDULE=03:00
CRON_MAX_ACCOUNTS=3
RUN_ON_STARTUP=false
